{{!< default}}
{{> header}}
<main class="main_will" role="main">
{{#post}}
<article class="article_will" role="article" itemscope itemtype="http://schema.org/Article">
<header class="postheader_will">
<time class="date_will" datetime="{{date format="YYYY-MM-DD"}}" itemprop="datePublished">{{date format='dddd DD MMM YYYY'}}</time>
<h1 class="posttitle_will" itemprop="headline">{{title}}</h1>
</header>
<div class="postcontent_will" itemprop="articleBody">
{{content}}
</div>
{{#if tags}}
<div class="posttags_will">
Tags: {{tags separator=" | "}}
</div>
{{/if}}
    <div class="sharepost_will">
    <h4 class="share_will">Share this post: &nbsp;</h4>
    <a class="share_will icon-twitter" target="_blank" href="http://twitter.com/share?text={{title}}&url={{url absolute="true"}}"><span class="hidethis_will">Twitter</span></a>
    <a class="share_will icon-facebook" target="_blank" href="http://www.facebook.com/sharer.php?u={{url absolute="true"}}"><span class="hidethis_will">Facebook</span></a>
    <a class="share_will icon-gplus" target="_blank" href="https://plus.google.com/share?url={{url absolute="true"}}"><span class="hidethis_will">Google+</span></a>
    </div>
        {{#if author}}
        <footer class="postfooter_will">
        <address itemscope itemtype="http://schema.org/Person">
        {{#if author.image}}
        <div class="authorimage_will"><img src="{{author.image}}" itemprop="image" /></div>
        {{/if}}
        <h4 class="authorname_will"><span itemprop="author">{{author.name}}</span></h4>
        {{#if author.website}}
        <div class="authorwebsite_will"><a href="{{author.website}}" itemprop="url">{{author.website}}</a></div>
        {{/if}}
        </address>
        <div class="authorbio_will">
        <p>{{author.bio}}</p>
        </div>
        </footer>
        {{/if}}
</article>
{{/post}}
{{#if pagination}}
<div class="pagination_will">
{{{pagination}}}
</div>
{{/if}}
</main>
{{> footer}}
